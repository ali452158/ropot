// ALFA Reports - Automated Trading Bot Database Schema
// Generator and datasource
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Activation codes - bound to a specific MT5 login (pre-provisioned in MetaApi dashboard)
model ActivationCode {
  id              String   @id @default(cuid())
  code            String   @unique
  status          String   @default("UNUSED") // UNUSED, ACTIVE, EXPIRED, REVOKED
  mt5Login        String?  // MT5 login this code is bound to (set at generation time)
  deviceFingerprint String? // null until first activation
  deviceInfo      String?  // user-agent / IP metadata
  activatedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String   @default("telegram-bot") // telegram-bot | admin
  notes           String?

  mt5Sessions     MT5Session[]
  trades          Trade[]

  @@index([code])
  @@index([status])
  @@index([mt5Login])
}

// MT5 session - created after successful activation + MT5 login
model MT5Session {
  id              String   @id @default(cuid())
  sessionId       String   @unique // internal session token
  activationCodeId String
  mt5Login        String   // MT5 account ID (e.g., "12345678")
  mt5Server       String   // e.g., "ICMarketsSC-Demo"
  mt5PasswordHash String   // we never store plain password; hash via MetaAPI proxy account
  metaApiAccountId String? // MetaAPI account ID created/provisioned for this MT5 login
  deviceId        String
  status          String   @default("ACTIVE") // ACTIVE, CLOSED, EXPIRED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // CopyFactory fields — populated when subscriber uses CopyFactory flow
  // (subscriber creates their own MetaApi account + Subscriber, gives us the ID).
  // When subscriberId is set, mt5Login/mt5Server/mt5PasswordHash are empty
  // (the subscriber never shares their MT5 credentials with us).
  copyFactorySubscriberId String? // CopyFactory Subscriber ID (e.g., "sub-abc123")
  copyFactoryStrategyId   String? // The strategy this subscriber is connected to
  copyFactoryState        String? // ACTIVE, DISCONNECTED, etc. (last known state)

  activationCode  ActivationCode @relation(fields: [activationCodeId], references: [id])
  botConfig       BotConfig?
  trades          Trade[]

  @@index([sessionId])
  @@index([activationCodeId])
  @@index([copyFactorySubscriberId])
}

// Bot configuration per session
model BotConfig {
  id              String   @id @default(cuid())
  sessionId       String   @unique
  symbol          String   @default("XAUUSD") // Gold
  timeframe       String   @default("M1")
  lotSize         Float    @default(0.01)
  tpPips          Float    @default(10)
  slPips          Float    @default(7)
  autoTpSl        Boolean  @default(true)
  timeExitMinutes Int      @default(1)
  minWickRatio    Float    @default(0.5)
  maxSpreadPips   Float    @default(3.0)
  // High-frequency mode: open a trade at every M1 candle close after wick touch.
  // When ON: the bot opens a trade on every newly-closed 1-minute candle whose
  // tail was touched by price. Direction is computed from the 1-minute trend
  // (EMA fast vs slow). Up to `maxOpenPositions` trades can run concurrently;
  // each trade auto-closes after `timeExitMinutes` (default 1 minute).
  highFrequencyMode Boolean @default(false)
  // Last M1 candle time the HF engine has already traded on (avoids duplicate
  // entries on the same candle). Stored as ISO string.
  lastHfCandleTime String?

  // === Trade direction preference (user-selected in the simplified UI) ===
  // "BUY"  → only BUY trades
  // "SELL" → only SELL trades
  // "AUTO" → let the strategy decide (trend-following)
  tradeDirection  String   @default("AUTO")

  // === Risk / position-management fields ===
  // Maximum number of concurrent open trades the bot can hold (HF mode).
  // NOTE: in the new batch-entry model, the bot opens `batchSize` trades at
  // once and waits for ALL of them to close before opening the next batch.
  // `maxOpenPositions` is kept as a hard ceiling so the bot can never exceed
  // this many simultaneous positions even if external positions exist.
  maxOpenPositions Int     @default(3)
  // Number of consecutive losing trades that triggers the auto-stop safety
  // ("السوق غير مستقر الآن"). Once hit, the bot stops itself.
  maxLossStreak    Int     @default(5)
  // Running counter of consecutive losing trades (reset on any win).
  lastLossStreak   Int     @default(0)
  // Flag set when the bot auto-stopped due to instability. Cleared on next
  // manual start.
  instabilityStop  Boolean @default(false)

  // === PYRAMID STRATEGY (new model — replaces batch-entry + candle-count) ===
  //
  // The bot opens 2 "anchor" trades on a qualifying signal. Each anchor
  // trade has SL = slPips pips and TP = 3 × slPips pips (i.e. tpPips is
  // computed as 3 × slPips at entry time and stored on the Trade row).
  //
  // As price moves in the trade direction, when ANY existing trade's
  // floating profit reaches `pyramidProfitUsd` (default $2), the bot opens
  // ONE more trade in the same direction with the same SL/TP rules. This
  // continues until `pyramidMaxTrades` (default 6) trades are open.
  //
  // Exit rules:
  //   - Each trade closes independently when its own TP is hit.
  //   - If price reverses and hits the SHARED anchor SL (the SL of the
  //     first 2 anchor trades), ALL open trades close immediately.
  //   - On full close (all trades exit), the bot re-evaluates for the next
  //     pyramid signal.
  //
  // pyramidProfitUsd: floating profit (USD) at which to add one more trade.
  //                  Default $2.
  // pyramidMaxTrades: max simultaneous trades in a pyramid. Default 6.
  // pyramidAnchorCount: how many trades to open on the initial signal.
  //                    Default 2.
  pyramidProfitUsd    Float    @default(2.0)
  pyramidMaxTrades    Int      @default(6)
  pyramidAnchorCount  Int      @default(2)
  // lastPyramidCandleTime: ISO time of the last M1 candle that triggered a
  //                       pyramid entry (avoids opening 2 pyramids on the
  //                       same candle).
  lastPyramidCandleTime String?

  // === SINGLE-TRADE STRATEGY (for non-gold pairs: EURUSD, GBPUSD, etc.) ===
  //
  // For all pairs EXCEPT XAUUSD, the bot uses a single-trade strategy:
  //   - Opens ONE trade per qualifying signal (EMA9/EMA21 trend-aligned).
  //   - Does NOT open another trade until the current one closes.
  //   - Exit is USD-based: closes when floating profit hits ±singleTpUsd /
  //     -singleSlUsd (default +$10 TP / -$3 SL).
  //   - The bot reads the broker's reported floating P/L (USD) on every tick,
  //     so it works correctly for ANY pair regardless of pip value / lot size.
  //
  // The strategy is auto-selected when symbol != "XAUUSD" — set
  // strategyMode = "single" on bot start. For XAUUSD, the Pyramid strategy
  // remains active (strategyMode = "pyramid").
  strategyMode      String   @default("pyramid")  // "pyramid" | "single"
  singleSlUsd       Float    @default(3.0)       // SL in USD (loss threshold)
  singleTpUsd       Float    @default(10.0)      // TP in USD (profit threshold)
  lastSingleCandleTime String?  // last M1 candle the single-strategy acted on

  // === Trailing Strategy fields (kept for the trailing-stop engine) ===
  strategyType    String   @default("trailing")
  autoPairScan    Boolean  @default(false)
  scanSymbols     String   @default("XAUUSD")
  atrPeriod       Int      @default(14)
  atrMultiplier   Float    @default(1.5)
  emaFast         Int      @default(9)
  emaSlow         Int      @default(21)
  minAtrPrice     Float    @default(0.10)
  breakevenAtr    Float    @default(0.8)
  maxTradeMinutes Int      @default(1)
  lastScanWinner  String?

  botRunning      Boolean  @default(false)
  botStartedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  session         MT5Session @relation(fields: [sessionId], references: [id])
}

// Trade records
model Trade {
  id              String   @id @default(cuid())
  activationCodeId String?
  sessionId       String?
  symbol          String
  direction       String   // BUY | SELL
  lotSize         Float
  entryPrice      Float
  exitPrice       Float?
  tpPips          Float
  slPips          Float
  tpPrice         Float?
  slPrice         Float?
  wickPrice       Float?   // the rejection wick price that triggered entry
  profitPips      Float?
  profitUsd       Float?
  status          String   @default("OPEN") // OPEN, CLOSED_TP, CLOSED_SL, CLOSED_TIME, CLOSED_MANUAL, ERROR
  openedAt        DateTime @default(now())
  closedAt        DateTime?
  durationSeconds Int?
  errorMessage    String?

  activationCode  ActivationCode? @relation(fields: [activationCodeId], references: [id])
  session         MT5Session?     @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([activationCodeId])
  @@index([status])
}

// System settings (MetaAPI token, etc.) - stored encrypted at rest conceptually
model SystemSetting {
  id    String @id
  value String
}
